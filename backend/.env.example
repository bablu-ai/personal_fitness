# ── Database ──────────────────────────────────────────────────────────────────
# Switch between SQLite (local dev, zero config) and PostgreSQL (production)
# by changing DATABASE_URL. Everything else stays the same.

# SQLite — default, no setup required
DATABASE_URL=sqlite:///./longevity.db

# PostgreSQL — uncomment and fill in your credentials
# DATABASE_URL=postgresql://postgres:password@localhost:5432/longevity
#
# For Docker Compose (docker-compose.yml in this directory):
# DATABASE_URL=postgresql://longevity:longevity@localhost:5432/longevity

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set one of these to enable the AI agent
# ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# LLM model to use (swap to change provider)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-nano
LLM_INGEST_MODEL=gpt-4.1-nano
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@example.com
